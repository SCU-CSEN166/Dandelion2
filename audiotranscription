from google.colab import files
from transformers import pipeline
from jiwer import wer, cer
import subprocess
import torch
import gc
import pandas as pd

# Upload your .opus recordings
uploaded = files.upload()
filenames = list(uploaded.keys())

# Convert recordings to WAV
wav_paths = []

for i, filename in enumerate(filenames):
    wav_path = f"/content/clip_{i}.wav"

    subprocess.run(
        ["ffmpeg", "-y", "-i", filename, "-ac", "1", "-ar", "16000", wav_path],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    wav_paths.append(wav_path)

device = 0 if torch.cuda.is_available() else -1
print("Using:", "GPU" if device == 0 else "CPU")

# Compare both models on the same recordings
model_ids = [
    "distil-whisper/distil-small.en",
    "openai/whisper-small.en",
]

predictions = {}

for model_id in model_ids:
    print(f"\nLoading {model_id}...")
    asr = pipeline(
        "automatic-speech-recognition",
        model=model_id,
        device=device,
    )

    model_predictions = []

    for filename, wav_path in zip(filenames, wav_paths):
        result = asr(wav_path)
        model_predictions.append(result["text"])
        print(f"\nFile: {filename}")
        print("Transcript:", result["text"])

    predictions[model_id] = model_predictions

    del asr
    gc.collect()
    if torch.cuda.is_available():
        torch.cuda.empty_cache()

# Enter the correct transcript for each recording, if you know it
references = []

for filename in filenames:
    reference = input(
        f"\nType the exact words spoken in {filename}, or press Enter to skip: "
    )
    references.append(reference.strip())

# Calculate scores for recordings with a reference transcript
scored = [
    i for i, reference in enumerate(references)
    if reference
]

if scored:
    for model_id in model_ids:
        refs = [references[i] for i in scored]
        preds = [predictions[model_id][i] for i in scored]

        print(f"\n{model_id}")
        print(f"WER: {wer(refs, preds):.3f}")
        print(f"CER: {cer(refs, preds):.3f}")
else:
    print("\nNo reference transcripts entered, so WER and CER were not calculated.")

# Save transcripts and any references to a CSV
report = pd.DataFrame({
    "filename": filenames,
    "reference_transcript": references,
    "distil_whisper_transcript": predictions[model_ids[0]],
    "whisper_small_transcript": predictions[model_ids[1]],
})

report.to_csv("audio_model_comparison.csv", index=False)
print("\nSaved: audio_model_comparison.csv")
display(report)
